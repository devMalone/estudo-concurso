{
  "name": "concurso-server",
  "version": "1.0.0",
  "description": "Backend API para gerenciamento do concurso com SQLite local e suporte a Supabase",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "tsx src/server.ts",
    "seed": "tsx src/seed/bacenTecnicoSeed.ts",
    "sync:supabase": "tsx src/syncSupabase.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
